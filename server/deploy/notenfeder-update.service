# Pulls a new server image and restarts the container if it changed.
# Install: see ../README.md, section "Raspberry Pi".
[Unit]
Description=Update Notenfeder server image
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/notenfeder
ExecStart=/usr/bin/docker compose pull --quiet server
ExecStart=/usr/bin/docker compose up -d server
# Removes dangling old images so the SD card does not fill up.
ExecStartPost=/usr/bin/docker image prune --force
