# Copy to .env next to compose.yaml and fill in. Never commit the real .env.

# Origins of the app (CORS, passkeys). Production and dev preview.
APP_ORIGINS=https://tablegrade.pages.dev,https://dev.tablegrade.pages.dev
# Passkey relying party id; changing it later invalidates all passkeys.
RP_ID=tablegrade.pages.dev

# Microsoft sign-in (personal accounts). Empty client id = off.
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=

# Google sign-in. Empty client id = off.
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=

# Never set in production: enables sign-in without credentials.
DEV_AUTH=

# rclone remote and folder for the backup, e.g. "gdrive:notenfeder" (see `rclone config`).
RCLONE_REMOTE=

# Image tag: "latest" (production) or "dev".
SERVER_TAG=latest
